# Copia este archivo a .env.local o ejecuta `npm run setup` para generarlo automáticamente.
# En producción (Vercel) estas mismas variables se introducen en Project → Settings → Environment Variables;
# genera los valores con: npm run env:production -- "email" "contraseña". Ver docs/DESPLIEGUE-VERCEL.md.
# Estas variables solo se leen en el servidor (no llevan el prefijo NEXT_PUBLIC_, salvo la URL de Supabase).

ADMIN_EMAIL=admin@spidermasks.local
# Hash scrypt generado con: npm run admin:hash -- "tu-contraseña"
ADMIN_PASSWORD_HASH=
# Cadena aleatoria de 32+ caracteres
SESSION_SECRET=

# Supabase: opcional en tu PC (si están vacías se usa data/db.json) y OBLIGATORIO en Vercel
# (sin Supabase la web publicada funciona en modo solo lectura).
NEXT_PUBLIC_SUPABASE_URL=
# ¡Secreta! Solo servidor. Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
